
```gitignore
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# OS Artifacts
.DS_Store
Thumbs.db
ehthumbs.db

# Heavy Machine Learning Artifacts (>100MB)
*.ckpt
*.pt
*.pth
*.onnx
# Small scikit-learn models (<10MB) can remain tracked:
!model_tier1.pkl